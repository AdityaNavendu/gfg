//---------------- Extended Euclid ---------------------//

ll extended_gcd(ll a,ll b,ll &x,ll &y){

    if(b==0){

        x=1;
        y=0;

        return a;
    }

    ll x1,y1;

    ll g=extended_gcd(b,a%b,x1,y1);

    x=y1;
    y=x1-(a/b)*y1;

    return g;
}

//---------------- Utility Functions -------------------//

bool isPowerOfTwo(ll x){
    return x>0 && (x&(x-1))==0;
}

bool isPerfectSquare(ll x){

    if(x<0)
        return false;

    ll r=sqrtl(x);

    return r*r==x;
}
