void solve(){
string s;
std::cin >> s;
int n=s.size();
   sort(s.begin(),s.end());
ll c=0;
for(int i=0; i<n; i++){
  c+=(i+1)*(s[i]-'a'+1);
}
std::cout << c << std::endl;
}

