//--------------------- Constants ----------------------//

const ll INF = 4e18;
const int MOD = 1e9+7;
const int MAXN = 2000005;

//------------------- Math Functions -------------------//

ll gcdll(ll a,ll b){
    return b?gcdll(b,a%b):a;
}

ll lcmll(ll a,ll b){
    return a/gcdll(a,b)*b;
}

ll modpow(ll a,ll b,ll mod=MOD){
    ll ans=1;
    a%=mod;

    while(b){
        if(b&1)
            ans=ans*a%mod;

        a=a*a%mod;
        b>>=1;
    }

    return ans;
}

ll modinv(ll a){
    return modpow(a,MOD-2);
}

ll mod_add(ll a,ll b){
    return (a+b)%MOD;
}

ll mod_sub(ll a,ll b){
    return (a-b+MOD)%MOD;
}

ll mod_mul(ll a,ll b){
    return (a*b)%MOD;
}

//---------------------- Sieve -------------------------//

vector<bool> prime;

void sieve(int n){

    prime.assign(n+1,true);

    prime[0]=prime[1]=false;

    for(int i=2;i*i<=n;i++){

        if(prime[i]){

            for(int j=i*i;j<=n;j+=i)
                prime[j]=false;
        }
    }
}

bool isPrime(ll n){

    if(n<(int)prime.size())
        return prime[n];

    if(n<2)
        return false;

    for(ll i=2;i*i<=n;i++)
        if(n%i==0)
            return false;

    return true;
}

//------------------- Combinatorics --------------------//

vector<ll> fact(MAXN),invfact(MAXN);

void init(){

    fact[0]=1;

    for(int i=1;i<MAXN;i++)
        fact[i]=fact[i-1]*i%MOD;

    invfact[MAXN-1]=modinv(fact[MAXN-1]);

    for(int i=MAXN-2;i>=0;i--)
        invfact[i]=invfact[i+1]*(i+1)%MOD;
}

ll nCr(ll n,ll r){

    if(r<0||r>n)
        return 0;

    return fact[n]*invfact[r]%MOD*invfact[n-r]%MOD;
}

ll nPr(ll n,ll r){

    if(r<0||r>n)
        return 0;

    return fact[n]*invfact[n-r]%MOD;
}

//---------------- Extended Euclid ---------------------//

ll extended_gcd(ll a,ll b,ll &x,ll &y){

    if(b==0){

        x=1;
        y=0;

        return a;
    }

    ll x1,y1;

    ll g=extended_gcd(b,a%b,x1,y1);

    x=y1;
    y=x1-(a/b)*y1;

    return g;
}

//---------------- Utility Functions -------------------//

bool isPowerOfTwo(ll x){
    return x>0 && (x&(x-1))==0;
}

bool isPerfectSquare(ll x){

    if(x<0)
        return false;

    ll r=sqrtl(x);

    return r*r==x;
}

void solve(){
    int d,x,y;
    cin >> d >> x >> y;
     if (x <= y) {
            cout << 0 << endl;
            return;
        }

    int c=0;

    while(y>=0){
        int p=x*(100-c*d)/100;

        if(p<=y){
            cout << c << endl;
            return;
        }

        c++;
        y--;
    }

    cout << -1 << endl;
}


